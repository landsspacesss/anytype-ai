# ---------------------------------------------------------------------------
# Copy this to `.env` and fill it in:  cp .env.example .env
#
# Required (the bot won't start without these):
#   ANYTYPE_API_BASE_URL, ANYTYPE_API_KEY, BOT_IDENTITY, and one model-provider
#   key (e.g. DEEPSEEK_API_KEY). Everything else has a sensible default.
# ---------------------------------------------------------------------------

# Reached via shared netns with anytype-cli (see docker-compose.bot.yml).
ANYTYPE_API_BASE_URL=http://127.0.0.1:31012
ANYTYPE_API_KEY=change-me
# Preferred: the bot account's stable identity. The bot's participant id is
# space-scoped, so main.ts resolves it per space from GET /v2/spaces/{id}/members
# by matching this identity. Leave BOT_PARTICIPANT_ID unset when this is set.
BOT_IDENTITY=change-me
# Fallback only (used when BOT_IDENTITY is unset).
BOT_PARTICIPANT_ID=
# The bot account's display name, used to strip <mention> tags from prompts.
BOT_DISPLAY_NAME=anytype-bot
# The embedded pi SDK agent needs a model provider key; pi reads these from env.
# Set whichever provider you use (e.g. DEEPSEEK_API_KEY, ANTHROPIC_API_KEY).
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# Optional: model used by the `web_search` tool (DeepSeek's hosted web search via
# its Anthropic-compatible Messages endpoint). Defaults to PI_MODEL when unset.
# Leave DEEPSEEK_API_KEY blank to disable `web_search` (the tool says so clearly).
SEARCH_MODEL=
# The `web_fetch` tool renders pages with the Lightpanda headless browser baked
# into the image. These tune the subprocess call.
LIGHTPANDA_BIN=lightpanda
WEB_FETCH_TIMEOUT_MS=30000
WEB_FETCH_MAX_CHARS=20000
# Root under which each space gets its own agent workspace dir (AGENTS.md/MEMORY.md).
AGENT_WORKSPACE_ROOT=/workspace
# Persist each chat's conversation history to disk (under <root>/sessions/<chat>/)
# so it survives a bot restart. Set to false for purely in-memory sessions.
# SESSION_PERSIST=true
# Optional: global pi config dir. Unset -> pi uses ~/.pi/agent.
PI_AGENT_DIR=
# Agent model id (registered via docker/models.json).
# deepseek-flash = DeepSeek V4.1 (native multimodal: text + image).
PI_MODEL=deepseek-flash
MAX_CONCURRENT_SESSIONS=3
IDLE_REAP_MS=900000
# Named sub-agents (the `agent` tool): max live agents per parent session, and
# the idle time (ms) after which a non-busy agent is lazily disposed.
MAX_SUBAGENTS=5
SUBAGENT_IDLE_MS=900000
REPLY_MAX_LEN=4000
# How often the cron scheduler ticks to check which watches are due (ms).
# Each watch is only polled when its own cron matches (see WATCH_DEFAULT_CRON).
WATCH_TICK_MS=60000
# Default cron (5 fields: minute hour dom month dow) for new watches that don't
# specify one. Every 30 minutes by default.
WATCH_DEFAULT_CRON=*/30 * * * *
# Cron is evaluated in LOCAL time; set this to the users' timezone so e.g.
# "每天早上9点" (`0 9 * * *`) fires at 09:00 local, not 09:00 UTC.
TZ=Asia/Shanghai

# Consecutive 404s before a watched object is treated as deleted (guards
# against dropping a watch on a transient read failure).
WATCH_MAX_MISSES=3

# Live tool-call status: post a self-updating "⏳ 正在 <tool>(args)…" message into
# the chat during a turn, then retract it when the turn ends. Set TOOL_STATUS=false
# to disable. The placeholder is only posted if the turn is still running after
# TOOL_STATUS_DELAY_MS, so fast replies don't flash it.
TOOL_STATUS=true
TOOL_STATUS_DELAY_MS=1500

# --- 其他模型 provider（可选）---------------------------------------------
# 每多配一个 key，就多一组可用模型（在 /model 里出现，可被工作流步骤的 model: 指定）。
# provider 定义在 docker/models.json。留空即不启用该 provider。
NVIDIA_API_KEY=
OPENCODE_API_KEY=

# --- 审批模式（可选）-------------------------------------------------------
# 新（非控制台）会话的默认审批模式：auto（从不问）/ ask（写操作先在聊天里问）/
# readonly（不能写）。控制台始终只读，与此无关。默认 auto。
APPROVAL_MODE=auto
# ask 模式下等待 /approve 的超时（ms），超时即拒绝。默认 300000（5 分钟）。
APPROVAL_TIMEOUT_MS=300000

# --- 控制台（全局助手，可选）-----------------------------------------------
# 指定控制台空间的 id；不设则读 <AGENT_WORKSPACE_ROOT>/console.json（由 /join 写入）。
CONSOLE_SPACE_ID=

# --- 工作流（可选）---------------------------------------------------------
# 工作流定义目录（镜像内已烘焙 docker/workflows → /app/workflows）；默认。
WORKFLOW_DIR=/app/workflows
# 每次运行的状态/日志目录；默认 <AGENT_WORKSPACE_ROOT>/workflow-runs。
WORKFLOW_RUN_DIR=
# 工作流「状态对话」的 chat id；不设则不发状态事件。默认空。
WORKFLOW_STATUS_CHAT=
