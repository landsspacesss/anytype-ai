# Reached via shared netns with anytype-cli (see docker-compose.bot.yml).
ANYTYPE_API_BASE_URL=http://127.0.0.1:31012
ANYTYPE_API_KEY=change-me
# Preferred: the bot account's stable identity. The bot's participant id is
# space-scoped, so main.ts resolves it per space from GET /v2/spaces/{id}/members
# by matching this identity. Leave BOT_PARTICIPANT_ID unset when this is set.
BOT_IDENTITY=A7D1kUBFSFfs7jBbTgFZ2uvp2Eo2eSpZWpjt52X41rMqZHPm
# Fallback only (used when BOT_IDENTITY is unset).
BOT_PARTICIPANT_ID=
# The bot account's display name, used to strip <mention> tags from prompts.
BOT_DISPLAY_NAME=anytype-bot
# The embedded pi SDK agent needs a model provider key; pi reads these from env.
# Set whichever provider you use (e.g. DEEPSEEK_API_KEY, ANTHROPIC_API_KEY).
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# Root under which each space gets its own agent workspace dir (AGENTS.md/MEMORY.md).
AGENT_WORKSPACE_ROOT=/workspace
# Optional: global pi config dir. Unset -> pi uses ~/.pi/agent.
PI_AGENT_DIR=
MAX_CONCURRENT_SESSIONS=3
IDLE_REAP_MS=900000
REPLY_MAX_LEN=4000
